#!/usr/bin/env bash
# sweatshop dev wrapper — everything runs in podman; nothing installs on the
# host. The repo is bind-mounted at /workspace and node_modules live in a
# named volume so the host tree never contains dependencies.
#
#   ./dev              install deps if needed, then run the dev server (attached)
#   ./dev install      npm install inside the container
#   ./dev exec -- CMD  one-off CMD in a container with the same mounts
#   ./dev shell        interactive shell in a fresh container
#   ./dev build        rebuild the dev image (Containerfile.dev)
#   ./dev clean        remove the dev container (volumes survive)
set -euo pipefail

IMAGE=localhost/sweatshop-dev
CONTAINER=sweatshop-dev
MODULES_VOLUME=sweatshop-node-modules
CACHE_VOLUME=sweatshop-npm-cache
# Host rootless podman socket, mounted into the dev container at the
# docker CLI's default path so the eve Docker sandbox provider creates
# sibling containers on host podman.
PODMAN_SOCK="${PODMAN_SOCK:-/run/user/1000/podman/podman.sock}"
# Host port for the dev server (3000 is taken by an unrelated host
# next-server on bee). Override with SWEATSHOP_PORT.
PORT="${SWEATSHOP_PORT:-3300}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The dev image bakes the docker CLI (see Containerfile.dev); build it on
# first use so plain ./dev just works.
podman image exists "$IMAGE" || podman build -t "$IMAGE" -f "$ROOT/Containerfile.dev" "$ROOT"

# Private network shared by the dev container (eve runtime) and session
# sandboxes (0006): bridge-backed harnesses (claude, later cursor) connect
# over it. Never published to the LAN — membership is the boundary.
HARNESS_NET=sweatshop-harness
podman network exists "$HARNESS_NET" 2>/dev/null || podman network create "$HARNESS_NET" >/dev/null

ENV_ARGS=()
if [[ -f "$ROOT/.env.local" ]]; then
  ENV_ARGS=(--env-file "$ROOT/.env.local")
elif [[ ! -f "$ROOT/.env.example" ]]; then
  echo "error: create .env.local (copy .env.example) before running sweatshop" >&2
  exit 1
fi

# Common mounts/identity for every invocation. Rootless podman maps
# container uid 0 to the host user, so container-root writes land
# host-owned; --user 0:0 keeps npm (and .next/, .eve/ artifacts in the
# bind mount) owned by crussell. (--userns=keep-id hits a crun
# empty-readlink bug on this host.)
common_args=(
  --user 0:0
  --network "$HARNESS_NET"
  -v "$ROOT":/workspace
  -v "$MODULES_VOLUME":/workspace/node_modules
  -v "$CACHE_VOLUME":/root/.npm
  -w /workspace
  "${ENV_ARGS[@]}"
)

# Mount the host podman socket when present: the eve Docker sandbox
# provider shells out to `docker`, which talks to this socket; sandboxes
# run as siblings on host podman (no nesting).
if [[ -S "$PODMAN_SOCK" ]]; then
  common_args+=(-v "$PODMAN_SOCK":/var/run/docker.sock)
fi

case "${1:-run}" in
  run)
    exec podman run --rm --init --replace --name "$CONTAINER" \
      -p "$PORT":3000 "${common_args[@]}" "$IMAGE" \
      sh -lc 'npm install --no-audit --no-fund && exec npm run dev'
    ;;
  install)
    exec podman run --rm "${common_args[@]}" "$IMAGE" \
      sh -lc 'npm install --no-audit --no-fund'
    ;;
  exec)
    shift
    [[ "${1:-}" == "--" ]] && shift
    exec podman run --rm "${common_args[@]}" "$IMAGE" "$@"
    ;;
  shell)
    exec podman run --rm -it "${common_args[@]}" "$IMAGE" bash
    ;;
  build)
    exec podman build -t "$IMAGE" -f "$ROOT/Containerfile.dev" "$ROOT"
    ;;
  clean)
    podman rm -f "$CONTAINER" 2>/dev/null || true
    ;;
  *)
    echo "usage: ./dev [run|install|exec -- CMD|shell|build|clean]" >&2
    exit 2
    ;;
esac
