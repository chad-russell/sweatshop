# Image build context trim (0091) — the build needs source + lockfiles
# only; everything else is local dev state or host coupling.
.git
.env
.env.*
!.env.example
data
node_modules
.next
tests
docs
design
.github
.forgejo
# dev image + sandbox image definitions; the serving image (this
# Containerfile) builds from the same tree but doesn't read them.
Containerfile.dev
Containerfile.sandbox
dev
