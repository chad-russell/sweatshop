# sweatshop dev container — stock node image plus the docker CLI the eve
# Docker sandbox provider shells out to. The daemon is NOT here: the
# wrapper bind-mounts the host rootless podman socket to
# /var/run/docker.sock, so provider-created sandboxes run as sibling
# containers on host podman.
FROM docker.io/library/node:24-trixie-slim

# docker-cli (the CLI the sandbox provider shells out through; no
# daemon — trixie's docker.io only *recommends* docker-cli, so name it
# explicitly) + git: 0017 — the New-preview branch picker runs
# `git ls-remote` from the Next process (0016 shipped without it and
# the picker was silently empty).
# gh (pinned exactly — Debian carries no gh package): 0033 — the
# agent's github discovery tool runs the real CLI in this container.
ARG GH_VERSION=2.102.0
RUN apt-get update \
  && apt-get install -y --no-install-recommends docker-cli git ca-certificates curl \
  && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.deb" -o /tmp/gh.deb \
  && apt-get install -y --no-install-recommends /tmp/gh.deb \
  && rm /tmp/gh.deb \
  && rm -rf /var/lib/apt/lists/*
