# sweatshop sandbox image — the shared base for directly provisioned
# project sandboxes (0004 Path B). Built on host podman via the mounted
# socket: ./dev exec -- docker build -t localhost/sweatshop-sandbox -f
# Containerfile.sandbox .  (The eve sandbox selector uses eve's own
# prepared image; this one is for workflow-provisioned containers.)
FROM docker.io/library/node:24-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl sudo \
  && rm -rf /var/lib/apt/lists/*

# python3/make/g++: node-gyp build toolchain — npm runs it for any gypfile
# dependency (better-sqlite3 et al.) even when a prebuilt binary exists;
# without these the whole npm install hard-fails (same reason the dev
# container carries them — see Containerfile.dev).
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# 0035: browser tools baked in for general-purpose use — anything the
# agent needs, not QA-only. The Chrome shared libraries are the list
# agent-browser's own --with-deps would install (it shells `sudo apt`,
# which this image only grants to the sandbox user, so they are explicit
# here as root). A custom project image without this layer degrades to
# agent-checkable: `command -v agent-browser` — never a tool gate.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libxcb-shm0 libx11-xcb1 libx11-6 libxcb1 libxext6 libxrandr2 \
    libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libgtk-3-0 \
    libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0 libcairo-gobject2 \
    libcairo2 libgdk-pixbuf-2.0-0 libxrender1 libasound2 libfreetype6 \
    libfontconfig1 libdbus-1-3 libnss3 libnss3-tools libnspr4 \
    libatk-bridge2.0-0 libdrm2 libxkbcommon0 libatspi2.0-0 libcups2 \
    libxshmfence1 libgbm1 fonts-noto-color-emoji fonts-noto-cjk \
    fonts-freefont-ttf \
  && rm -rf /var/lib/apt/lists/*

# Bridge-backed harnesses (claude) bootstrap their in-sandbox bridge with
# `pnpm install`; pinned to the version eve's own sandbox image ships.
RUN npm install -g pnpm@11.5.2 agent-browser@0.38.2 && npm cache clean --force

# gh CLI: agents attach before/after screenshots to PRs with
# `gh pr edit --attach` (AGENTS.md "PR screenshots"). Pinned; bump and rebuild.
ARG GH_VERSION=2.103.2
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /tmp && install /tmp/gh_${GH_VERSION}_linux_amd64/bin/gh /usr/local/bin/gh \
    && rm -rf /tmp/gh_${GH_VERSION}_linux_amd64

# Non-root agent user with passwordless sudo — the same shape as eve's
# own sandbox image (vercel-sandbox). Claude Code refuses to run its
# permission-skipping mode as root, so bridge harnesses need this.
RUN useradd -m -s /bin/bash sandbox \
  && echo "sandbox ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/sandbox \
  && chmod 0440 /etc/sudoers.d/sandbox

# Project repos clone here (same convention as eve session sandboxes).
# /work/<runId> holds machine runs' repos (0009: a root that never
# collides with the dev runtime's own /workspace mount).
RUN mkdir -p /workspace /work && chown sandbox:sandbox /workspace /work

# 0035: Chrome for Testing downloaded at BUILD time into the sandbox
# user's ~/.agent-browser — nothing downloads at runtime. Pinned by the
# image build; bump the agent-browser pin above and rebuild to move.
USER sandbox
RUN agent-browser install
# 0035 follow-up (2026-10-09 post-mortem): bake the CLI's own usage skill
# where harnesses find it — run 2's implement learned agent-browser by
# --help and one-subcommand-per-step; the skill teaches refs + batch.
RUN mkdir -p /home/sandbox/.claude/skills/agent-browser   && agent-browser skills get core > /home/sandbox/.claude/skills/agent-browser/SKILL.md
USER root

WORKDIR /workspace
USER sandbox

# Keep the container alive; commands enter via docker exec.
CMD ["sleep", "infinity"]
