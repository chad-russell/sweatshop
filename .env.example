# ————— Provider keys (one is enough to run) —————
# z.ai GLM coding plan — also the first `web_search` backend (Z.AI's MCP tool).
ZAI_API_KEY=
# web_search tries backends in order and falls through on missing/failed:
# zai -> codex (the ChatGPT login from /settings, no key) -> claude -> tavily.
# With none configured web_search answers "not configured"; web_fetch always works.
# Claude's key is deliberately NOT ANTHROPIC_API_KEY (that would shadow the claude harness login).
ANTHROPIC_SEARCH_API_KEY=
TAVILY_API_KEY=
# Optional: comma-separated backend ids to reorder/narrow the list (zai,codex,claude,tavily).
WEB_SEARCH_PROVIDERS=
# Alternative providers — either replaces GLM as the derived default
# (glm > openrouter > gloo; see SWEATSHOP_DEFAULT_* below).
GLOO_API_KEY=
OPENROUTER_API_KEY=

# dev wrapper: which engine runs everything (auto|podman|docker;
# auto = podman when installed, else docker). DOCKER_SOCK overrides the
# docker socket probe (OrbStack/colima/Docker Desktop) — podman-only
# setups ignore it (PODMAN_SOCK there). DEV_PUBLISH publishes ports for
# the all-local mode; default publishes nothing.
CONTAINER_ENGINE=
DOCKER_SOCK=
DEV_PUBLISH=

# Owner identity — the human this tool serves. Agent-facing strings
# interpolate the name (default "Chad"); the git identity is for
# sandbox commits.
SWEATSHOP_OWNER_NAME=
GIT_USER_NAME=
GIT_USER_EMAIL=

# Git host credentials for the gh / forgejo tools (no seed script — the
# `npm run db:seed` vars are gone). Credentials live as rows in the
# `git_credentials` table (id, kind "github"|"forgejo", label, username,
# secret, baseUrl — forgejo only): insert them directly, e.g.
#   sqlite3 data/sweatshop.db "insert into git_credentials \
#     (id,kind,label,username,secret,baseUrl,createdAt) values \
#     ('github-me','github','gh','you','ghp_…',null,CAST(strftime('%s','now') AS INTEGER)*1000)"
# (The project page shows which credential a repo resolves to.)

# Claude Code harness (0006) — a claude setup-token (claude
# setup-token). Passed to the in-sandbox CLI as CLAUDE_CODE_OAUTH_TOKEN
# via the adapter's env channel; single-user personal use per the 0006
# amendment (docs/0006-claude-harness.md).
CLAUDE_CODE_OAUTH_TOKEN=
# (cursor and codex harnesses authenticate from login files instead —
# see README; no env vars here.)

# Sandbox image — overrides the default image ref a sandbox runs when
# its project pins none (default localhost/sweatshop-sandbox, built
# from Containerfile.sandbox; see docs/agent/sandboxes.md).
SWEATSHOP_SANDBOX_IMAGE=

# ————— Previews (0016; all optional) —————
# Host suffix preview URLs live under: <scheme>://pv-<slug>.<base>.
# Unset, the base falls back to `previews.localhost` (this machine).
PREVIEW_BASE_DOMAIN=
# URL scheme for preview links (default: http on the previews.localhost
# fallback — no wildcard cert locally — https otherwise; set to override)
PREVIEW_URL_SCHEME=
# Proxy listener inside the dev container (3001; `off` disables). ./dev
# publishes it on the host's Nebula IP (PREVIEW_PUBLISH=10.10.0.12:3301).
PREVIEW_PROXY_PORT=
# Reconcile + follow tick (every 30 s; `off` disables)
PREVIEW_TICK=
# Where the "not running" page links back to (e.g. http://sweatshop:3300).
# Also the OpenRouter attribution referer sent with API calls
# (default http://localhost:3000).
SWEATSHOP_PUBLIC_ORIGIN=
# Idle windows: stop a preview after N hours with no traffic (12); destroy
# a branch preview's own sandbox N days after its preview stops (7)
GC_PREVIEW_STOP_HOURS=
GC_PREVIEW_DESTROY_DAYS=

# ————— Defaults (optional; both required to count) —————
# Override the derived built-in default routes for chat/agent/pi/titles:
# SWEATSHOP_DEFAULT_PROVIDER + SWEATSHOP_DEFAULT_MODEL (e.g. provider
# "openrouter", model "anthropic/claude-sonnet-4.6"). An unknown provider
# or a half-set pair is ignored — the per-surface pickers in /settings
# override these anyway.
SWEATSHOP_DEFAULT_PROVIDER=
SWEATSHOP_DEFAULT_MODEL=

# Workflow SDK local world (0020). The sweatshop service sets both of
# these so in-flight runs, hooks and gates live with the db (backed up)
# instead of withWorkflow()'s default .next/ (which a build can wipe).
# BOTH are required: withWorkflow() overwrites WORKFLOW_LOCAL_DATA_DIR
# whenever WORKFLOW_TARGET_WORLD is unset. Leave unset here.
# WORKFLOW_TARGET_WORLD=local
# WORKFLOW_LOCAL_DATA_DIR=
