# z.ai GLM coding plan — copy to .env.local
ZAI_API_KEY=

# pi harness model override (optional; default zai-glm/glm-5.3-flash)
PI_MODEL=

# git identity for sandbox commits (optional; defaults shown)
GIT_USER_NAME=
GIT_USER_EMAIL=

# git credentials for `npm run db:seed` (optional; skipped when absent)
GITHUB_USERNAME=
GITHUB_TOKEN=
FORGEJO_URL=
FORGEJO_USERNAME=
FORGEJO_TOKEN=

# Claude Code harness (0006) — a claude setup-token (claude
# setup-token). Passed to the in-sandbox CLI as CLAUDE_CODE_OAUTH_TOKEN
# via the adapter's env channel; single-user personal use per the 0006
# amendment (docs/0006-claude-harness.md).
CLAUDE_CODE_OAUTH_TOKEN=

# Previews (0016) — all optional; defaults shown.
# Host suffix preview URLs live under: https://pv-<slug>.<base>
PREVIEW_BASE_DOMAIN=
# Proxy listener inside the dev container (3001; `off` disables). ./dev
# publishes it on bee's Nebula IP (PREVIEW_PUBLISH=10.10.0.12:3301).
PREVIEW_PROXY_PORT=
# Reconcile + follow tick (every 30 s; `off` disables)
PREVIEW_TICK=
# Where the "not running" page links back to (e.g. http://bee:3300)
SWEATSHOP_PUBLIC_ORIGIN=
# Idle windows: stop a preview after N hours with no traffic (12); destroy
# a branch preview's own sandbox N days after its preview stops (7)
GC_PREVIEW_STOP_HOURS=
GC_PREVIEW_DESTROY_DAYS=

# Workflow SDK local world (0020). The sweatshop service sets both of
# these so in-flight runs, hooks and gates live with the db (backed up)
# instead of withWorkflow()'s default .next/ (which a build can wipe).
# BOTH are required: withWorkflow() overwrites WORKFLOW_LOCAL_DATA_DIR
# whenever WORKFLOW_TARGET_WORLD is unset. Leave unset here.
# WORKFLOW_TARGET_WORLD=local
# WORKFLOW_LOCAL_DATA_DIR=
