# z.ai GLM coding plan — copy to .env.local
ZAI_API_KEY=

# pi harness model override (optional; default zai-glm/glm-5.3-flash)
PI_MODEL=

# git identity for sandbox commits (optional; defaults shown)
GIT_USER_NAME=
GIT_USER_EMAIL=

# git credentials for `npm run db:seed` (optional; skipped when absent)
GITHUB_USERNAME=
GITHUB_TOKEN=
FORGEJO_URL=
FORGEJO_USERNAME=
FORGEJO_TOKEN=

# Claude Code harness (0006) — Anthropic Console API key. NOT the
# claude.ai subscription setup-token (claude setup-token); see
# docs/0006-claude-harness.md's authentication gate.
ANTHROPIC_API_KEY=
